{
  "description": "Same as bigdata2025-steam, with the instances of the paper's code (index column kept, labels in review order). 20 users (seeds 0 to 19), 5 runs each, horizon 500, noise 0.1, delta = 1/T, hyperparameters of the paper for this dataset.",
  "env": {
    "kind": "dataset",
    "function": "bigdata2025_instances",
    "name": "steam",
    "n_instances": 20,
    "paper_code": true
  },
  "policies": [
    {
      "policy": "LinUCB",
      "alpha": 0.003,
      "lambda_": 1000.0,
      "delta": 0.002
    },
    {
      "policy": "ConfidenceBall1",
      "alpha": 0.01,
      "lambda_": 0.001,
      "delta": 0.002
    },
    {
      "policy": "ConfidenceBall1",
      "n_components": 50,
      "projection": "fjlt",
      "alpha": 0.1,
      "lambda_": 2e-07,
      "delta": 0.002
    },
    {
      "policy": "CBRAP",
      "n_components": 50,
      "alpha": 0.1,
      "lambda_": 2e-09,
      "delta": 0.002
    },
    {
      "policy": "SOFUL",
      "sketch_size": 10,
      "alpha": 1.0,
      "lambda_": 2e-05,
      "delta": 0.002
    },
    {
      "policy": "CBSCFD",
      "sketch_size": 10,
      "alpha": 0.1,
      "lambda_": 2e-09,
      "delta": 0.002
    },
    {
      "policy": "Random"
    }
  ],
  "experiment": {
    "horizon": 500,
    "n_runs": 5,
    "seed": 0,
    "log_interval": 5
  }
}
